# Copy to .env (or set as GitHub Actions secrets) for release builds.
# Leave empty to use Google's test ads.
# Read by Gradle (android/app/build.gradle), not Vite:
ADMOB_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
VITE_ADMOB_REWARDED_ID=ca-app-pub-xxxxxxxxxxxxxxxx/zzzzzzzzzz
VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-xxxxxxxxxxxxxxxx/wwwwwwwwww
VITE_PRIVACY_POLICY_URL=https://teoptrs.github.io/echo-beat/privacy-policy.html
